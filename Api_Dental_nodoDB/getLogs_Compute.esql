CREATE COMPUTE MODULE getLogs_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        SET OutputLocalEnvironment = InputLocalEnvironment;
        
        SET Environment.Variables.Users.Row[] =
            PASSTHRU('SELECT id, empresa_id, sucursal_id, name, email, activo, created_at, updated_at FROM users ORDER BY created_at DESC');

        SET OutputRoot = NULL;
        SET OutputRoot.Properties = InputRoot.Properties;
        
        CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
        
        SET OutputRoot.JSON.Data.exitoso = TRUE;
        SET OutputRoot.JSON.Data.mensaje = 'Usuarios obtenidos correctamente';
        
        CREATE FIELD OutputRoot.JSON.Data.usuarios IDENTITY(JSON.Array)usuarios;

        IF EXISTS(Environment.Variables.Users.Row[]) THEN
            
            DECLARE userRef REFERENCE TO Environment.Variables.Users.Row[1];
            DECLARE jsonRow REFERENCE TO OutputRoot; 
            
            WHILE LASTMOVE(userRef) DO
                CREATE LASTCHILD OF OutputRoot.JSON.Data.usuarios AS jsonRow NAME 'Item';
                
                SET jsonRow.id          = userRef.id;
                SET jsonRow.empresaId   = userRef.empresa_id;
                SET jsonRow.sucursalId  = userRef.sucursal_id;
                SET jsonRow.nombre      = userRef.name;
                SET jsonRow.correo      = userRef.email;
                SET jsonRow.activo      = userRef.activo;
                
                SET jsonRow.created_at  = CAST(userRef.created_at AS CHARACTER);
                SET jsonRow.updated_at  = CAST(userRef.updated_at AS CHARACTER);

                MOVE userRef NEXTSIBLING;
            END WHILE;
            
        ELSE
            SET OutputRoot.JSON.Data.mensaje = 'No se encontraron usuarios en la base de datos';
        END IF;
        
        RETURN TRUE;
    END;
END MODULE;